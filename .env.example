# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Required: your DataRobot API token
DATAROBOT_API_TOKEN=

# Optional: override the DataRobot endpoint (default: https://app.datarobot.com/api/v2)
# DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2

# Optional: override the generation model (default: claude-opus)
# AGENTS_MD_MODEL=datarobot/anthropic/claude-opus-4-5-20251101

# Optional: override the evaluation model (default: claude-sonnet)
# AGENTS_MD_TEST_MODEL=datarobot/anthropic/claude-sonnet-4-5-20250929

# Optional: route all LLM calls through a specific deployed model
# LLM_DEPLOYMENT_ID=
